{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VeriIDE Project Configuration",
  "description": "Schema for project.yaml — text-based engineering project metadata",
  "type": "object",
  "required": ["name", "safety_level", "svm_version", "logic_files"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name (alphanumeric + underscore)",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "safety_level": {
      "type": "string",
      "enum": ["SIL1", "SIL2", "SIL3"],
      "description": "IEC 61508 safety integrity level"
    },
    "svm_version": {
      "type": "string",
      "description": "Target SafeASM VM version (semver)",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "logic_files": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Ordered list of ST source files in logic/ directory (PRE merge order). Empty list means no logic files yet."
    },
    "description": {
      "type": "string",
      "description": "Optional project description"
    }
  },
  "additionalProperties": false
}
