# vstac 项目 .gitignore
# 忽略编译中间文件和生成产物

# ================================================================
# 构建输出目录（所有 C 编译产物）
# ================================================================
# 必须锚定仓库根：未锚定时它会连 veri-ide/src/veri_ide/backend/build/
# 这个 Python 包（构建编排服务）一起吞掉。
/build/

# pytest 缓存（.pytest_cache/ 自带 .gitignore，这里显式列出以免依赖该文件）
.pytest_cache/

# 临时输出文件
output.sasm
output.txt

# RT-Thread 移植构建产物
*.elf

# 目标文件
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib

# 预编译头
*.gch
*.pch

# 依赖文件
*.d
*.dep

# ================================================================
# Coq 编译产物
# ================================================================
# Coq 编译中间文件
*.vo
*.vio
*.vok
*.vos
*.glob
*.aux
*.cache

# Coq 编译缓存
.coq-native/

# ================================================================
# OCaml 编译产物 (Coq Extraction 目标)
# ================================================================
*.cmx
*.cmo
*.cmi
*.cmxa
*.cma

# 提取生成的 OCaml 代码（Coq Extraction 产出）
veri-stc/extraction/*.ml
veri-stc/extraction/*.mli
!veri-stc/extraction/veristc_main.ml

# 组件构建产物（一律收敛到 build/，源码树内不得留存二进制）
veri-stc/extraction/veristc
veri-stc/extraction/.extract_stamp
veri-runtime/core/svm
veri-runtime/core/svm-asan
veri-runtime/tests/vm-tests/test_vm
veri-runtime/tests/vm-tests/test_vm-asan
veri-runtime/tests/vm-tests/test_io_mapping
veri-runtime/tests/vm-tests/test_hotstandby
veri-runtime/tests/vm-tests/test_nuclear_protection_full_e2e

# Dune 构建缓存
_build/

# 编辑器/IDE 临时文件
*~
*.swp
*.swo
*.o
*.obj
*.exe
*.byte
*.opt

# dune 构建产物
_build/
*.install

# ================================================================
# IDE / 编辑器
# ================================================================
# VS Code
.vscode/settings.json
.vscode/launch.json
*.code-workspace

# Vim
*.swp
*.swo
*.swn
*~

# Emacs
*#
.#*
\#*\#

# ================================================================
# 系统文件
# ================================================================
.DS_Store
Thumbs.db
*.log
*.tmp

# ================================================================
# Python 生成器产物 (保留生成的 .sasm 示例供版本控制)
# ================================================================
__pycache__/
*.pyc
*.pyo

# ================================================================
# 测试生成的文件
# ================================================================
/veri-runtime/tests/**/*.log
/veri-runtime/tests/**/*.out
/veri-stc/tests/**/*.log
/veri-stc/tests/**/*.out

# MISRA-C 检查产物 (run_misra_check.sh)
.misra_report.txt
.misra_reports/
docs/veristc-paper.html
.vorg.db

# ================================================================
# VeriIDE 工程站组件 (Phase 6)
# ================================================================

# Node.js 依赖
veri-ide/node_modules/
veri-ide/web/node_modules/

# Tauri 构建产物
veri-ide/src-tauri/target/
veri-ide/src-tauri/WixTools/

# Vite 构建输出
veri-ide/web/dist/

# Python 包信息
veri-ide/src/veri_ide.egg-info/
veri-ide/veri_ide.egg-info/

# PySide6 桌面应用（已迁移到 Tauri，保留代码但忽略构建产物）
veri-ide/src/veri_ide/desktop/__pycache__/
veri-ide/src/veri_ide/desktop/*.pyc

# 前端构建临时文件
veri-ide/.pnpm-store/
veri-ide/pnpm-lock.yaml

# IDE 完成报告（可选：如需保留请注释掉）
# veri-ide/G*_COMPLETION_REPORT.md

# 前端原型 HTML（已迁移到 React 组件）
# veri-ide/frontend/public/*.html
