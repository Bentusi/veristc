// flow-compile-pipeline.dot
// VeriSTC 编译管线数据流 (当前状态 / AS-IS) —— flow-visualizer + graphviz
// 问题: 一个 .st 源文件从触发到产出可执行镜像，数据形态如何逐步变化，门禁在哪拒绝，四种模式如何分叉。
// 证据: veri-stc/extraction/veristc_main.ml (生产入口) + veri-stc/src/*.v (被提取的计算函数)
// 读法: 命令行分派在最上方; -c/-g 共用 frontend(), -a 走 analyze_st() 这条**重复实现且门禁更少**的管线, -x 完全不读 .st。
//       八边形 = 终止编译的门禁; 虚线簇 = 存在但不在生产运行路径上的部分。
// 重新渲染: dot -Tsvg flow-compile-pipeline.dot -o flow-compile-pipeline.svg
// 行号刷新: 2026-10-28 随 Phase 6 G0(W1/W2/W2') 全量重导。三处结构性变化已入图:
//   (a) 失败出口从裸 failwith 改为带退出码的 die exit_*(0/11/21/22/23/24/25) + --json NDJSON；
//   (b) -c 在 encode 之后新增两道主机侧真值覆盖: patch_iomap_cal(量程) 与 emit_debug_section(段 7 符号表)；
//   (c) IOMAP 的 mem_offset 由 Coq 侧按名取段 7 同一张表，运行站写映射的位置 == 程序读写的变量。
digraph "veristc_compile_pipeline" {
    graph [
        rankdir=TB,
        label="VeriSTC 编译管线数据流 (AS-IS)\n触发: ST 工程师执行 veristc [-a|-c|-g|-x] [--json] input.st [-o out]\n证据日期 2026-10-28",
        labelloc=t, fontsize=18, fontname="Helvetica",
        nodesep=0.3, ranksep=0.6, newrank=true, bgcolor="white"
    ];
    node [shape=box, style="rounded,filled", fontsize=11, fontname="Helvetica", fillcolor="#eaf3ff", color="#57606a"];
    edge [fontsize=10, fontname="Helvetica", color="#57606a"];

    st_file [shape=note, fillcolor="#f2cc60", color="#9a6b00", label="ST 源程序 (.st)\nIEC 61131-3 文本"];

    mode [shape=diamond, fillcolor="#fff0f6", color="#bf3989",
          label="命令行模式分派 parse_args\nveristc_main.ml:808-841\n选项可任意位置; 无动作参数时默认 -a :840\n-c/-g 缺 -o 即 exit 11, 绝不写 CWD :843-846"];
    st_file -> mode [label="argv", color="#bf3989", penwidth=1.4];

    // ================= 共享前端: -c / -g 使用 =================
    subgraph cluster_frontend {
        label="前端 frontend()  veristc_main.ml:423-482   —— -c / -g 共用";
        style="rounded,dashed"; color="#0969da"; fontsize=12;

        abort [shape=octagon, fillcolor="#ffe2e2", color="#cf222e",
               label="die exit_* → 非零退出 (G0/W1)\n语法 21 / 语义 22 / 资源 23 / 制品 24 / 内部 25\nveristc_main.ml:125-135\n--json 时诊断走 stdout NDJSON, 否则 stderr 单行"];

        read_file [label="read_file\nstring -> Coq String\n定义 :57 | 调用 :425"];
        lex       [label="Lexer.lex\nstring -> list token\nlexer.v:377 | 调用 :215"];
        parse     [label="Parser.parse\nlist token -> st_program\nparser.v:1330 | 调用 :220\n(v1.5.1: inst.field 在此融合为 inst#field)"];
        dupchk    [label="check_no_duplicate_declarations\nst_program -> bool\ntypechecker.v:184 | 调用 :432-434"];
        funcprep  [label="Function_check.prepare_program\nst_program -> option st_program\nfunction_check.v:1084 | 调用 :435\n(内含 expand_instances → inst#field 全局)"];
        dupchk2   [label="duplicate_declaration_msg (v1.5.1)\nst_program -> option 冲突名\ntypechecker.v:262 | 调用 :444-452"];
        funcdiag  [label="check_program_full_diag / _rows\nst_program -> 诊断\nfunction_check.v:1227,1608 | 调用 :453-461\n(v1.5.1: 含 check_program_access :1034, KIND=access)"];
        normalize [label="Inline.normalize_program\n保留函数结构的规范化\ninline.v:647 | 调用 :464"];
        inlineopt [label="Inline.optimize_inline_program\n叶子内联 + 死函数消除\ninline.v:942 | 调用 :468"];
        desugar   [label="Desugar.desugar_program\nst_program -> corest_program\ndesugar.v:409 | 调用 :471"];
        analyze   [label="Analysis.analyze\ncorest -> 调用图/栈深/WCET\nanalysis.v:242 | 调用 :474"];
        gates     [shape=diamond, fillcolor="#ffe9d5", color="#fb8500",
                   label="安全门禁\n递归调用 → 拒绝 :475-477\n静态栈深 > 上限 → 拒绝 :478-481"];

        read_file -> lex -> parse -> dupchk -> funcprep -> dupchk2 -> funcdiag -> normalize -> inlineopt -> desugar -> analyze -> gates;

        lex       -> abort [label="None → \"lexer failed\" :217", style=dashed, color="#cf222e", constraint=false];
        parse     -> abort [label="None → parse_fail_pos + lex_offsets\n回推行列 :223-233", style=dashed, color="#cf222e", constraint=false];
        dupchk    -> abort [label="false → 扁平命名空间重名 :431-433", style=dashed, color="#cf222e", constraint=false];
        funcprep  -> abort [label="None → FUNCTION 非法/缺 PROGRAM :436-438", style=dashed, color="#cf222e", constraint=false];
        dupchk2   -> abort [label="Some 名字 → 展开后重名\n带名字拒绝 :445-451", style=dashed, color="#cf222e", constraint=false];
        funcdiag  -> abort [label="诊断非空 → 作用域/纯性/调用类型/字段封装 :456-461", style=dashed, color="#cf222e", constraint=false];
        normalize -> abort [label="None → 规范化失败 :464-466", style=dashed, color="#cf222e", constraint=false];
        inlineopt -> abort [label="pou_list = 0 :468-470", style=dashed, color="#cf222e", constraint=false];
        desugar   -> abort [label="函数列表为空 :471-473", style=dashed, color="#cf222e", constraint=false];
        gates     -> abort [label="超限/递归 → 终止", style=dashed, color="#cf222e"];
    }
    mode -> read_file [label="-c / -g", color="#0969da", penwidth=1.6];

    // ================= -a: 重复实现的独立管线 =================
    subgraph cluster_analyze {
        label="模式 -a: analyze_st()  veristc_main.ml:721-780   —— 与 frontend 重复实现";
        style="rounded,dashed"; color="#bf3989"; fontsize=12;

        a_chain [label="read_file → parse_or_fail → 重名门禁 → prepare_program\n→ 展开后重名门禁 → check_program_full_diag → normalize_program\n→ optimize_inline_program → desugar_program → analyze\n:722-760  十步与 frontend:425-474 逐行同构\n前 9 步门禁与 frontend 相同, 失败即 die exit_* 终止",
                 fillcolor="#fff0f6"];
        a_print [label="四项指标发出, 无文件产物\n--json: {kind:analysis,...} 单行 :763-771\n文本: stack depth / recursive calls / wcet / loops bounded :772-779",
                 fillcolor="#f6f8fa"];
        a_gap   [label="★ 门禁差异: -a 只报告 recursive 与 stack_depth\n不做 frontend:475-481 的递归拒绝与栈深拒绝\n→ 同一程序 -a 报告通过、-c 编译失败 是可能的",
                 fillcolor="#ffe9d5", color="#cf222e"];
    }
    mode -> a_chain [label="-a (默认)", color="#bf3989", penwidth=1.4];
    a_chain -> a_print;
    a_chain -> a_gap [style=dotted, color="#cf222e", fontcolor="#cf222e"];

    // ================= -c: 生成 .sasm =================
    subgraph cluster_compile {
        label="模式 -c: 生成 .sasm  compile_st_to_sasm  veristc_main.ml:484-499"; style="rounded"; color="#1a7f37"; fontsize=12;

        gc_codegen [label="Global_codegen.compile_program_gc\ncorest_program -> sasm_module\n(全局偏移 + FB 实例 + IOMap 段)\nIOMAP 的 mem_offset 按名向 build_global_env 取真实槽位\nglobal_codegen.v:801,61,46 | 调用 :486",
                    fillcolor="#dcf5e3"];
        encode     [label="Encoder.encode_module\nsasm_module -> list Z 字节\n(定宽小端, 非 LEB128)\nCoq 无 IEEE-754 位 ⇒ IOMAP scale/bias 此处写占位零\nencoder.v:327 | 调用 :489",
                    fillcolor="#dcf5e3"];
        cal_patch  [label="patch_iomap_cal (OCaml 侧量程真值)\n按 compile_module_io_cal_info 的 IR 值覆盖条目 [18-33] 的 float64\n条目数/段长/通道号三重核对不符 → die exit_internal(25)\n绝不产出半成品镜像\nveristc_main.ml:375-421 | 调用 :488-492",
                    fillcolor="#dcf5e3"];
        dbg_emit   [label="emit_debug_section + splice_debug (段 7)\nCoq compile_program_debug_info 出行(含 inst#field 派生名)\n→ STRPOOL+SYMTAB 字节, 插在尾部 CRC 占位之前\nveristc_main.ml:293-335,337-368 | 调用 :493-497",
                    fillcolor="#dcf5e3"];
        crc        [label="attach_crc32 (手写 OCaml)\n对 [6, len-4) 求 CRC32(长度 len-10)\n回填尾部 4 字节 ⇒ 段 7 自动被覆盖\nlen<10 → die exit_internal(25)\nveristc_main.ml:255-265 | 调用 :499",
                    fillcolor="#dcf5e3", color="#cf222e"];
        write_sasm [label="write_file  :501-... | 调用 :864\n--json 发 {kind:output,path,bytes}", shape=note, fillcolor="#f2cc60", color="#9a6b00"];
        sasm_file  [label=".sasm 镜像\nHeader|段表|IOMap(段3)|Code|Debug(段7)|CRC32", shape=note, fillcolor="#f2cc60", color="#9a6b00"];

        gc_codegen -> encode [label="sasm_module"];
        encode     -> cal_patch [label="带占位量程的字节串"];
        cal_patch  -> dbg_emit [label="量程已真的 image"];
        dbg_emit   -> crc      [label="image + 段 7"];
        crc        -> write_sasm;
        write_sasm -> sasm_file [label="文件写"];
        gc_codegen -> cal_patch [label="compile_module_io_cal_info :491", style=dotted, color="#1a7f37"];
        gc_codegen -> dbg_emit  [label="compile_program_debug_info :496", style=dotted, color="#1a7f37"];
    }
    gates -> gc_codegen [label="-c: corest", color="#1a7f37", penwidth=1.6];

    // ================= -g: 生成 .svobj =================
    subgraph cluster_svobj {
        label="模式 -g: 生成 .svobj —— Coq 出扁平元数据 / OCaml 出字节布局"; style="rounded"; color="#8250df"; fontsize=12;

        reloc_info [label="compile_program_reloc_info\nreloc_row = (kind, 符号, func, off, addend)\nglobal_codegen.v:1021 (scan_instrs :960) | :578",
                    fillcolor="#ece6fb"];
        inst_info  [label="compile_program_inst_info\n(iname, fbname, base, size)\nglobal_codegen.v:1037 | :583",
                    fillcolor="#ece6fb"];
        sym_info   [label="compile_program_sym_info\nsym_row = (name, kind, aux)\nglobal_codegen.v:1072 | :589",
                    fillcolor="#ece6fb"];
        alias      [label="build_alias_table\n从调用点派生 VAR_IN_OUT 别名\n→ GLOBAL_OFF(kind=2) 行\n别名判定优先于基址判定\nglobal_codegen.v:934",
                    fillcolor="#ece6fb"];
        svobj_emit [label="emit_svobj (手写 OCaml)\n排序/去重 + put_u8/16/32\nHeader36B|SYMTAB|RELOC|BLOCKS|IMAGE|CRC32\nveristc_main.ml:574-647",
                    fillcolor="#ece6fb"];
        svobj_file [label=".svobj 对象", shape=note, fillcolor="#f2cc60", color="#9a6b00"];

        alias      -> reloc_info [label="别名窗口内的\nI32_CONST 候选", style=dashed];
        reloc_info -> svobj_emit [label="RELOC 表"];
        inst_info  -> svobj_emit [label="BLOCKS 表"];
        sym_info   -> svobj_emit [label="SYMTAB 表"];
    }
    gates -> reloc_info [label="-g: corest", color="#8250df", penwidth=1.4];
    gc_codegen -> svobj_emit [label="IMAGE: 复用同一条\ngc+encode+patch_iomap_cal 结果 :617-625", color="#8250df", style=dashed];
    svobj_emit -> svobj_file [label="文件写 :873", color="#8250df"];

    // ================= -x: 对象自检 =================
    subgraph cluster_verify {
        label="模式 -x: 对象自检 (不读 .st)"; style="rounded,dashed"; color="#bf3989"; fontsize=12;
        svobj_verify [label="verify_svobj\n纯 OCaml 反向走查 magic/长度/段计数/CRC\n不经任何 Coq 计算函数\nveristc_main.ml:649-719",
                      fillcolor="#fff0f6"];
    }
    mode -> svobj_verify [label="-x: 输入是 .svobj", color="#bf3989", style=dashed];
    svobj_file -> svobj_verify [label="读回", style=dashed, color="#bf3989"];

    // ================= 证明层旁注 =================
    subgraph cluster_proof {
        label="构建期证明层 —— 不产出运行期代码"; style="rounded,dotted"; color="#57606a"; fontsize=11;
        specs [label="veri-stc/spec/safest.v, veri-stc/spec/safeasm.v\nst_program / sasm_module 类型定义\n+ derived_field_sep = \"#\"(v1.5.1 保留分隔符)\n→ 作为提取模块进入可执行文件\nsafest.v:357,94 | safeasm.v:282,293",
               fillcolor="#f6f8fa"];
        thms  [label="端到端语义保持链\ncompile_st_to_sasm = compile_core_program (:85-99)\n= type_check_program + codegen.compile_program\n定理 :1688 :1739 :2007 :2204 :2216",
               fillcolor="#e6f4ea"];
        thms_gc [label="生产路径的定理(仅结构性质, WS-C 段)\ncompile_program_gc 段长度/CALL 目标存在\n/形参数<=局部槽位数  :2228-2493\n※ 不含端到端 semantics preservation\n※ 段 7 与量程覆盖是主机侧行为, 无定理",
                 fillcolor="#fff8c5"];
        dead  [label="证明路径专用 / 已提取但入口未调用:\ncodegen.compile_program(:1077)\ntypechecker.type_check_program(:626)\nglobal_codegen.compile_program_g(:289)\ninline.inline_program(:367)",
               fillcolor="#ffe9d5"];
        specs -> thms [label="Require", style=dotted];
        specs -> thms_gc [label="Require", style=dotted];
    }
    desugar -> specs [label="类型定义", style=dotted, color="#8b949e", constraint=false];
    gc_codegen -> dead [label="生产函数不在端到端定理组合内\n(有意的解耦边界)", style=dotted, color="#fb8500", constraint=false];

    // ================= 下游: 三个主程序 =================
    sasm_file -> svm_load [label="fread 载入", color="#1a7f37"];
    svm_load [shape=box, label="svm 纯执行器\n见 flow-vm-runtime.dot", fillcolor="#d0e8ff"];
    sasm_file -> sim_load [label="fread 载入", color="#1a7f37"];
    sim_load [shape=box, label="sim 闭环仿真\nio_mapping_cycle + .plant + --watch\n见 flow-vm-unwired.dot ①", fillcolor="#d0e8ff"];
    sasm_file -> agent_load [label="首装进版本槽", color="#1a7f37"];
    agent_load [shape=box, label="veristc-agent 目标端\nDLF1 帧下装 + 周期边界换版 + 健康窗回滚\n见 flow-vm-unwired.dot ③", fillcolor="#d0e8ff"];
    svobj_file -> linker [label="预期消费者", style=dotted, color="#8b949e"];
    linker [shape=box, label="veristc-ld (P3 计划)\n仓库内尚无实现 → 目标态", fillcolor="#f6f8fa", color="#8b949e", style="rounded,dashed"];

    note1 [shape=note, fillcolor="#fff8c5", color="#9a6b00", fontsize=10,
           label="关键事实\n1) 分派在最前: -c 与 -g 各自完整跑一遍 frontend, 无法在一次调用内同时产出两种文件。\n2) -a 是第二条管线(analyze_st), 与 frontend 十步同构但少了递归/栈深门禁 → 报告口径与编译口径可能不一致。\n3) 类型检查在生产路径只落到重名门禁; 形式化 typing 关系(type_check_program)不在生产路径。\n4) 证明/生产解耦是有意设计: 端到端 semantics preservation 建立在 compile_program + type_check_program 上\n   (compiler_correctness.v:85-99), 生产走 compile_program_gc(串入 csites/fbctx); gc 路径只有 CALL 结构定理(:2228-2493)。\n5) 两处真值只在 OCaml 主机侧成形: IOMAP 量程(占位零 → patch_iomap_cal)与段 7 符号表(Coq 出行 → emit_debug_section)。\n   二者都不在 Coq 语义里 ⇒ 任何「编码字节正确」的断言只能是测试, 不是定理。"];
    { rank=sink; note1; }
}
